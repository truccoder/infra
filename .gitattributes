# Bất kỳ script .sh/.sql nào scp sang máy chủ Linux rồi chạy bằng bash phải giữ đầu dòng LF.
# Repo này commit từ Windows (core.autocrlf=true); một shebang kết thúc bằng CR làm Linux báo
# "not found" trỏ vào một file đang nằm sờ sờ ở đó. (Repo backend đã dính đúng lỗi này với gradlew.)
*.sh  text eol=lf
*.sql text eol=lf
